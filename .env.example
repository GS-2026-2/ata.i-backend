# Copie para .env e preencha. NUNCA versione o arquivo .env.
#   cp .env.example .env
#
# Formato: CHAVE=valor (sem aspas e sem espaços ao redor do "=").

# Perfil Spring: local | prod
SPRING_PROFILES_ACTIVE=local

# Oracle Database (FIAP) — formato: jdbc:oracle:thin:@//HOST:PORT/SERVICE_NAME
DB_URL=jdbc:oracle:thin:@//HOST:PORT/SERVICE_NAME
DB_USERNAME=
DB_PASSWORD=

# Porta HTTP da aplicação
PORT=8080
